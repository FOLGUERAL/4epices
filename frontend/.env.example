# Clés Groq utilisées uniquement par les routes API Next.js (ne pas préfixer par NEXT_PUBLIC_).
# Le compte 1 accepte aussi l'ancien nom GROQ_API_KEY pour compatibilité.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b

# Fournisseurs alternatifs de l'outil d'administration
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Publicité (variables NEXT_PUBLIC_* figées au build : à fournir aussi au build Docker)
NEXT_PUBLIC_ENABLE_ADSENSE=false
# Un slot AdSense par emplacement pour mesurer chacun ; NEXT_PUBLIC_GOOGLE_ADS_SLOT sert de repli
NEXT_PUBLIC_GOOGLE_ADS_SLOT=
NEXT_PUBLIC_GOOGLE_ADS_SLOT_RECIPE_AFTER_INGREDIENTS=
NEXT_PUBLIC_GOOGLE_ADS_SLOT_RECIPE_AFTER_PREPARATION=

# Statistiques d'audience Umami (optionnel, figé au build). Voir la doc Umami Cloud : identifiant du site.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Laisser vide pour Umami Cloud ; renseigner l'URL du script si vous hébergez Umami vous-même
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Secret admin (serveur uniquement, jamais NEXT_PUBLIC_*) : voir ADMIN_AUTH.md
ADMIN_SECRET=
