{
  "kind": "collectionType",
  "collectionName": "ustensiles",
  "info": {
    "singularName": "ustensile",
    "pluralName": "ustensiles",
    "displayName": "Ustensile",
    "description": "Ustensiles de cuisine avec lien d'affiliation Amazon Associates"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nom": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nom",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "lienAmazon": {
      "type": "string",
      "required": false
    },
    "recettes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::recette.recette",
      "inversedBy": "ustensiles"
    }
  }
}
